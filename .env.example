# === 資料庫（MariaDB 11.7）===
DB_HOST=db
DB_PORT=3306
DB_NAME=monitoring
DB_USER=monitor
DB_PASSWORD=change-me-db-password
# root 密碼供容器初始化用
DB_ROOT_PASSWORD=change-me-root-password

# SQLAlchemy 連接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# === JWT / 安全 ===
# 以 `openssl rand -hex 32` 產生，請勿使用此預設值
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === 即時資料生成器 ===
GENERATOR_INTERVAL_SECONDS=1
ANOMALY_THRESHOLD=80.0
GENERATOR_CATEGORIES=cpu,memory,disk,network

# === 批次寫入策略 ===
BATCH_SIZE=50
BATCH_INTERVAL_SECONDS=5

# === 資料保留（天）===
REALTIME_RETENTION_DAYS=30
LOG_RETENTION_DAYS=90
RETENTION_CLEANUP_INTERVAL_HOURS=24

# === 批量導入上限 ===
IMPORT_MAX_ROWS=10000
IMPORT_MAX_BYTES=10485760

# === 種子測試帳號（初始化建立；正式環境請改密碼）===
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_USERNAME=user
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User@12345
SEED_VIEWER_USERNAME=viewer
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=Viewer@12345

# === 一般設定 ===
TIMEZONE=Asia/Taipei
LOG_LEVEL=INFO
# CORS 允許來源（前端）
CORS_ORIGINS=http://localhost:8501

# === 前端串接後端位址 ===
API_BASE_URL=http://backend:8000
WS_BASE_URL=ws://backend:8000
